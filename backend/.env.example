# copy to .env to override defaults. (backend\.env also holds the generated database passwords - created by `python -m app.bootstrap_db`, never commit it)
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://127.0.0.1:11434
CACHE_TTL_SECONDS=300

# database (XAMPP MariaDB)
XAMPP_DIR=D:\IDE\xampp
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=panorama
DB_USER=panorama_app            # runtime account: least privilege
DB_PASSWORD=                    # generated by bootstrap_db
DB_OWNER_USER=panorama_owner    # schema owner: migrations, loading, backups
DB_OWNER_PASSWORD=              # generated by bootstrap_db
DB_POOL_SIZE=8

# sessions & login screen
SESSION_IDLE_MINUTES=60
JWT_TTL_HOURS=8
DEMO_MODE=1            # 0 hides the demo accounts (and their passwords) on the login screen
COOKIE_SECURE=0        # set to 1 when the app is served over HTTPS
