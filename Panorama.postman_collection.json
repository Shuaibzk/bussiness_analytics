    {
      "name": "3. Role security proof",
      "item": [
        {
          "name": "Asia manager: same query, only Asia comes back",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/query",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metrics\": [\n    \"revenue\"\n  ],\n  \"group_by\": [\n    \"region\"\n  ],\n  \"filters\": {},\n  \"basis\": \"net\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_asia}}",
                  "type": "string"
                }
              ]
            },
            "description": "No region filter was sent. The server adds WHERE region = 'Asia' itself."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('only Asia', () => { const r = pm.response.json().rows; pm.expect(r.length).to.eql(1); pm.expect(r[0][0]).to.eql('Asia'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ops asks for profit: refused (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/query",
