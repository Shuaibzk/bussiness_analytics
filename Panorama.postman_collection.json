              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_ops}}",
                  "type": "string"
                }
              ]
            },
            "description": "Operations is not allowed to see pricing, cost or profit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ops calls an admin endpoint: refused (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/admin/users",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "admin",
                "users"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
