        {
          "name": "Net revenue by region (all 4 regions)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/query",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metrics\": [\n    \"revenue\"\n  ],\n  \"group_by\": [\n    \"region\"\n  ],\n  \"filters\": {},\n  \"basis\": \"net\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "description": "The one governed query endpoint behind every chart. The response includes the SQL that ran."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('4 regions', () => pm.expect(pm.response.json().rows.length).to.eql(4));"
                ]
