          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "No token at all: refused (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_nocookie}}/api/kpis",
              "host": [
                "{{base_nocookie}}"
              ],
              "path": [
                "api",
                "kpis"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {},\n  \"basis\": \"net\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Uses 127.0.0.1 instead of localhost on purpose: Postman stores the login cookie per host, so this host has no cookie and the request is truly anonymous."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
