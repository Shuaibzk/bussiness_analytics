{
  "info": {
    "name": "Panorama Analytics API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folder 1 first (it saves a token per role), then show folders 2 and 3. Needs the app running on port 8000."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8000"
    },
    {
      "key": "base_nocookie",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "token_asia",
      "value": ""
    },
    {
      "key": "token_ops",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check (no login needed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/health",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Shows the API and MariaDB are up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Log in (run these first)",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Saves the token into the collection variable {{token_admin}} automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_admin', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as asia.manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
